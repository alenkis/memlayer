;; Application configuration — Aero-tagged EDN.
;; Non-secret defaults are inline; env vars override via #env tags.
;; Secrets (.env) are loaded by bb tasks (load-dotenv) or dotenv-java (REPL).
;;
;; To override a setting: set the corresponding env var, e.g.
;;   MEMLAYER_PORT=8081 make server
;;   DASHBOARD_PORT=3001 make dashboard-dev

{:server {:port #long #or [#env MEMLAYER_PORT 8080]
          :dashboard-port #long #or [#env DASHBOARD_PORT 3000]}

 :datahike {:backend #keyword #or [#env DATAHIKE_BACKEND "file"]
            :path #or [#env DATAHIKE_PATH ".memlayer/db"]}

 :proximum {:dim 1536
            :capacity #long #or [#env PROXIMUM_CAPACITY 100000]
            :backend #keyword #or [#env PROXIMUM_BACKEND "file"]
            :path #or [#env PROXIMUM_PATH ".memlayer/vectors"]}

 :openai {:api-key #env OPENAI_API_KEY
          :base-url #or [#env OPENAI_BASE_URL "https://api.openai.com/v1"]
          :embedding-model #or [#env OPENAI_EMBEDDING_MODEL "text-embedding-3-small"]}

 :groq {:api-key #env GROQ_API_KEY
        :base-url #or [#env GROQ_BASE_URL "https://api.groq.com/openai/v1"]
        :model #or [#env GROQ_MODEL "llama-3.3-70b-versatile"]}

 :prompts {:extraction       "prompts/extraction.edn"
           :batch-extraction "prompts/batch-extraction.edn"
           :decision         "prompts/decision.edn"
           :resolution       "prompts/resolution.edn"
           :reflect          "prompts/reflect.edn"
           :reflect-organize        "prompts/reflect-organize.edn"
           :reflect-organize-domains "prompts/reflect-organize-domains.edn"
           :reflect-summarize        "prompts/reflect-summarize.edn"
           :reflect-connect          "prompts/reflect-connect.edn"
           :reflect-curate           "prompts/reflect-curate.edn"
           :recall                   "prompts/recall.edn"}

 :auth {:e2e-mode #boolean #or [#env AUTH_E2E_MODE false]
        :api-key-hash #env API_KEY_HASH}

 :firebase {:project-id #or [#env FIREBASE_PROJECT_ID "memlayer-c69b1"]}

 :dynamodb {:endpoint #env DYNAMODB_ENDPOINT
            :region #or [#env AWS_REGION "us-east-1"]
            :table #env DYNAMODB_TABLE}

 :rate-limit {:enabled #boolean #or [#env RATE_LIMIT_ENABLED true]
              :max-requests #long #or [#env RATE_LIMIT_RPM 60]
              :window-ms 60000}

 :flow {:io-threads #long #or [#env FLOW_IO_THREADS 8]
        :submit-timeout-ms #long #or [#env FLOW_SUBMIT_TIMEOUT_MS 120000]}

 :cost {:embedding-per-1k-tokens  #double #or [#env COST_EMBEDDING_PER_1K 0.00002]
        :chat-prompt-per-1k-tokens #double #or [#env COST_CHAT_PROMPT_PER_1K 0.00027]
        :chat-completion-per-1k-tokens #double #or [#env COST_CHAT_COMPLETION_PER_1K 0.00027]}

 :tuning {:retain-context-threshold #double #or [#env RETAIN_CONTEXT_THRESHOLD 0.4]
          :retain-context-limit #long #or [#env RETAIN_CONTEXT_LIMIT 10]
          :recall-default-limit #long #or [#env RECALL_DEFAULT_LIMIT 10]
          :reflect-batch-size #long #or [#env REFLECT_BATCH_SIZE 15]
          :reflect-default-threshold #double #or [#env REFLECT_DEFAULT_THRESHOLD 0.5]
          :memory-limit #long #or [#env MEMORY_LIMIT 1000]}}
