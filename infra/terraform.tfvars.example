# Copy to terraform.tfvars and customize
# Secrets come via TF_VAR_* env vars from 1Password (make infra-plan/apply)

aws_region          = "us-east-1"
instance_type       = "t3.small"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ebs_volume_size     = 20
allowed_ssh_cidrs   = ["0.0.0.0/0"] # Restrict to your IP: ["YOUR_IP/32"]
