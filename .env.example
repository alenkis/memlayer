# Secrets only — copy to .env and fill in your API keys:
#   cp .env.example .env
#
# Or if you use 1Password:
#   make env
#
# Non-secret settings (ports, paths, flags) are in config.edn.

# Required
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Optional
# API_KEY_HASH=...
# DYNAMODB_ENDPOINT=...
# DYNAMODB_TABLE=...
